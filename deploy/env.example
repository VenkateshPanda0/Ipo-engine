# Copy to deploy/.env. Secrets do NOT go here: they are files under deploy/secrets/ (see the compose file).

# The address people type in the browser, and the API's address as the browser sees it.
PUBLIC_BASE_URL=https://app.example.com
PUBLIC_API_URL=https://app.example.com/api

# invite: only invited people can sign in. open: anyone with a verified Google address gets an account.
SIGNUP_MODE=invite

# Google sign-in is optional. Leave empty to keep it off; put the client secret in deploy/secrets/google_client_secret.
GOOGLE_CLIENT_ID=

# Requests per signed-in user per minute (0 = no limit).
API_RATE_LIMIT_PER_MINUTE=600
