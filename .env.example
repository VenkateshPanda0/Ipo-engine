# Environment variables — IPO Engine
# Copy to .env and adjust. NEVER commit .env. Every value below has a safe local default;
# the engine needs no paid API, cloud service or LLM credential.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# "production" disables the interactive /docs and /redoc pages
APP_ENV=development
LOG_LEVEL=INFO
# json: one JSON object per line (default, for log shippers); text: one readable line per record.
LOG_FORMAT=json
# A Prometheus /metrics endpoint, readable by the admin role only. Off by default; counters are
# per process (a restart resets them).
METRICS_ENABLED=false
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Persistence (SQLite by default; migrations run automatically at startup)
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app/ipo_due_diligence.db
# uploaded PDFs (content-addressed) and temp files
DATA_DIR=./data/app
RETAIN_DOCUMENTS=true
# stored PDFs are purged after this; metadata, hashes and audit remain
RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Authentication. Keys are mapped to roles server-side:
#   API_KEYS=<user_id>|<role>|<key or sha256=<hex digest>>,...
#   roles: viewer < analyst < reviewer < admin
# Prefer sha256= digests so plaintext keys are not stored in configuration; make one with
#   printf '%s' "$KEY" | ipo keys hash
# With no keys, every caller is a local admin. That is allowed in development only:
# APP_ENV=production with no keys REFUSES TO START unless ALLOW_UNAUTHENTICATED=true (below).
# ---------------------------------------------------------------------------
API_KEYS=
# legacy single key, maps to an analyst principal
API_KEY=
# Run production with no authentication on purpose (e.g. behind a gateway that authenticates).
# Logs a warning at start; responses carry 'X-IPO-Engine-Auth: disabled'.
ALLOW_UNAUTHENTICATED=false
# Set true only when TLS is terminated in front of the API: adds Strict-Transport-Security
# (production only).
TRUST_HTTPS=false

# ---------------------------------------------------------------------------
# Regulatory
# ---------------------------------------------------------------------------
RULESET_VERSION=2.0.0
# Keep false until a qualified securities-law professional has reviewed the rules.
REGULATORY_VALIDATION_CONFIRMED=false
REGULATORY_VALIDATION_REFERENCE=

# ---------------------------------------------------------------------------
# Document processing limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=1500
# requires the tesseract binary; skipped gracefully if absent
OCR_ENABLED=true
MAX_OCR_PAGES=60
OCR_DPI=200
PROCESSING_TIMEOUT_S=900
WORKER_THREADS=2
UPLOAD_RATE_LIMIT_PER_MINUTE=30

# ---------------------------------------------------------------------------
# docker compose only (see compose.yaml)
# ---------------------------------------------------------------------------
# The address the *browser* uses to reach the API; fixed when the web image is built.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
